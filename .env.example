# Template konfigurasi AI (OpenAI-compatible).
# Cara pakai: salin file ini menjadi `.env`, lalu isi nilai di bawah ini.
# `.env` JANGAN di-commit (sudah di .gitignore) — hanya `.env.example` yang di-commit.

# Base URL endpoint OpenAI-compatible (tanpa /chat/completions, berakhiran /v1).
# Contoh: https://api.openai.com/v1  |  https://openrouter.ai/api/v1  |  https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Nama model yang dipakai untuk chat.
# Contoh: gpt-4o-mini  |  meta-llama/llama-3.1-70b-instruct
OPENAI_MODEL=

# API key dari provider-mu. Kosongkan kalau mau diisi lewat Profil > Asisten AI.
OPENAI_API_KEY=
